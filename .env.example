# Names only. Put the real values in a file called .env (never commit it).
NEXT_PUBLIC_SUPABASE_URL=
# Holds the Supabase publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Holds the Supabase secret key. Server only. Never use a NEXT_PUBLIC_ name for it.
SUPABASE_SERVICE_ROLE_KEY=
# Added in a later phase. Server only.
RESEND_API_KEY=
# Verified Resend sender address. Server only.
RESEND_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
